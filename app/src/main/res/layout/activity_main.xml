<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Weather/season/holiday image from Home Assistant (BackgroundController). -->
    <ImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <!-- Darkens the left side so the text over it stays readable. -->
    <dev.alex.minlauncher.Scrim
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- TV overscan-safe gutters. The right padding is set in code: it keeps
         the content in the left part of the screen, clear of the image's
         focal element. -->
    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="64dp"
        android:paddingRight="64dp"
        android:paddingTop="48dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="64sp"
            android:textColor="@color/fg"
            android:fontFamily="sans-serif-thin"
            android:letterSpacing="-0.02"
            android:shadowColor="@color/text_shadow"
            android:shadowDy="1"
            android:shadowRadius="6" />

        <TextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="18sp"
            android:textColor="@color/subtitle"
            android:fontFamily="sans-serif-medium"
            android:shadowColor="@color/subtitle_shadow"
            android:shadowDy="1"
            android:shadowRadius="8" />

        <!-- Daily forecast from Home Assistant; gone when there is none. -->
        <TextView
            android:id="@+id/forecast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:visibility="gone"
            android:textSize="18sp"
            android:textColor="@color/subtitle"
            android:fontFamily="sans-serif-medium"
            android:shadowColor="@color/subtitle_shadow"
            android:shadowDy="1"
            android:shadowRadius="8" />

        <!-- Current weather from Home Assistant; gone when there is none. -->
        <TextView
            android:id="@+id/weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:visibility="gone"
            android:textSize="18sp"
            android:textColor="@color/subtitle"
            android:fontFamily="sans-serif-medium"
            android:shadowColor="@color/subtitle_shadow"
            android:shadowDy="1"
            android:shadowRadius="8" />

        <ScrollView
            android:id="@+id/scroller"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="28dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
